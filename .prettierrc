{
    "tabWidth": 2,
    "singleQuote": true,
    "semi": true,
    "trailingComma": "es5",
    "printWidth": 100,
    "bracketSpacing": true,
    "overrides": [
        {
            "files": "*.html",
            "options": {
                "tabWidth": 4
            }
        },
        {
            "files": "*.css",
            "options": {
                "tabWidth": 4
            }
        }
    ]
}
